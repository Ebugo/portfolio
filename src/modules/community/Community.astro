---
import Section from "@modules/core/Section.astro";
import { SITE_CONTENT } from "@config";

const { community } = SITE_CONTENT;
---

<Section id="community" class="py-32">
  <div class="mb-24 reveal-on-scroll">
    <h2 class="font-display font-bold text-[10vw] md:text-[8vw] leading-[0.9] tracking-tighter text-text-main">
      Community.
    </h2>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-24">
    <!-- Talks Section -->
    <div class="reveal-on-scroll" style="transition-delay: 0.1s">
      <h3 class="font-display font-bold text-4xl mb-12 flex items-center gap-4">
        <span class="w-3 h-3 rounded-full bg-primary"></span>
        Talks & Speaking
      </h3>
      
      <div class="space-y-8">
        {community.talks.map((talk) => (
          <a href={talk.link} target="_blank" rel="noopener noreferrer" class="block group border-b border-white/10 pb-8 hover:border-primary/50 transition-colors">
            <div class="flex justify-between items-start mb-2">
              <h4 class="text-2xl font-bold text-text-main group-hover:text-primary transition-colors">{talk.title}</h4>
              <span class="text-sm font-mono text-text-muted border border-white/10 px-2 py-1 rounded-full">{talk.type}</span>
            </div>
            <div class="flex justify-between items-center text-text-muted text-sm font-mono uppercase tracking-wider">
              <span>{talk.event}</span>
              <span>{talk.date}</span>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Engagements Section -->
    <div class="reveal-on-scroll" style="transition-delay: 0.2s">
      <h3 class="font-display font-bold text-4xl mb-12 flex items-center gap-4">
        <span class="w-3 h-3 rounded-full bg-secondary"></span>
        Engagements
      </h3>
      
      <div class="space-y-12">
        {community.engagements.map((engagement) => (
          <div class="group">
            <h4 class="text-2xl font-bold text-text-main mb-2">{engagement.title}</h4>
            <div class="flex items-center gap-3 text-sm font-mono uppercase tracking-wider text-primary mb-4">
              <span>{engagement.organization}</span>
              <span class="w-1 h-1 rounded-full bg-white/20"></span>
              <span class="text-text-muted">{engagement.date}</span>
            </div>
            <p class="text-text-muted leading-relaxed">{engagement.description}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</Section>
