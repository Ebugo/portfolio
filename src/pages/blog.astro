---
import BoldLayout from "@layouts/BoldLayout.astro";
import Section from "@modules/core/Section.astro";
import BlogCard from "@modules/blog/BlogCard.astro";
import { SITE_CONTENT } from "@config";
import "../styles/global.css";

const { blog } = SITE_CONTENT;
---

<BoldLayout title="Blog | Gospel Chinyereugo">
  <div class="pt-32 pb-20 px-6 md:px-12 lg:px-24">
    <Section fullWidth={true} class="max-w-5xl mx-auto">
      <div class="mb-16">
        <h1 class="text-4xl md:text-6xl font-bold mb-6">Blog</h1>
        <p class="text-xl text-text-muted max-w-2xl">
          Thoughts, tutorials, and insights on software engineering, accessibility, and blockchain.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {
          blog.map((post) => (
            <BlogCard post={post} />
          ))
        }
      </div>
    </Section>
  </div>
</BoldLayout>
