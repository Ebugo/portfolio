---
import { SITE_CONFIG, SITE_CONTENT } from "@config";

const { siteLogo, navLinks, socialLinks } = SITE_CONFIG;
const { name, specialty } = SITE_CONTENT.hero;
---

<aside class="fixed top-0 left-0 h-screen w-full md:w-80 bg-surface border-r border-border flex flex-col p-8 z-50 transition-transform duration-300 -translate-x-full md:translate-x-0" id="sidebar">
  <div class="mb-12">
    <a href="/" class="block mb-6 group">
      <div class="relative w-24 h-24 rounded-full overflow-hidden border-2 border-border group-hover:border-primary transition-colors duration-300">
        <img src={siteLogo} alt={name} class="object-cover w-full h-full" />
      </div>
    </a>
    <h1 class="font-display text-2xl font-bold text-text-main mb-1">{name}</h1>
    <p class="text-text-muted text-sm">{specialty}</p>
  </div>

  <nav class="flex-grow">
    <ul class="space-y-4">
      {navLinks.map((link) => (
        <li>
          <a 
            href={link.href} 
            class="flex items-center text-lg font-medium text-text-muted hover:text-primary transition-colors group"
          >
            <span class="w-8 h-[1px] bg-border mr-4 group-hover:bg-primary transition-colors"></span>
            {link.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="mt-auto">
    <div class="flex flex-wrap gap-4">
      {socialLinks.map((link) => (
        <a 
          href={link.href} 
          target="_blank" 
          rel="noopener noreferrer"
          class="text-text-muted hover:text-primary transition-colors"
          aria-label={link.text}
        >
          <span class="sr-only">{link.text}</span>
          {/* Simple icons mapping based on text, fallback to generic link icon */}
          {link.text.includes('GitHub') || link.text.includes('Github') ? (
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
          ) : link.text.includes('LinkedIn') ? (
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
          ) : link.text.includes('Twitter') || link.text.includes('X') ? (
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/></svg>
          ) : (
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          )}
        </a>
      ))}
    </div>
    <p class="text-xs text-text-muted mt-6">© {new Date().getFullYear()} Gospel C.</p>
  </div>
</aside>

<button 
  id="mobile-menu-toggle" 
  class="fixed top-4 right-4 z-[60] p-2 bg-surface border border-border rounded-full md:hidden text-text-main"
  aria-label="Toggle Menu"
>
  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-menu"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
</button>

<div 
  id="sidebar-overlay" 
  class="fixed inset-0 bg-black/50 z-40 opacity-0 pointer-events-none transition-opacity duration-300 md:hidden"
></div>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const sidebar = document.getElementById('sidebar');
  const overlay = document.getElementById('sidebar-overlay');
  let isOpen = false;

  function toggleMenu() {
    isOpen = !isOpen;
    if (isOpen) {
      sidebar?.classList.remove('-translate-x-full');
      overlay?.classList.remove('opacity-0', 'pointer-events-none');
      if (toggleBtn) {
        toggleBtn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>`;
      }
    } else {
      sidebar?.classList.add('-translate-x-full');
      overlay?.classList.add('opacity-0', 'pointer-events-none');
      if (toggleBtn) {
        toggleBtn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>`;
      }
    }
  }

  toggleBtn?.addEventListener('click', toggleMenu);
  overlay?.addEventListener('click', toggleMenu);
</script>
