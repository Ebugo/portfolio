---
import Section from "@modules/core/Section.astro";
import { SITE_CONTENT } from "@config";

const { about, projects } = SITE_CONTENT;
---

<Section id="about" class="py-24 md:py-32">
  <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-24">
    <!-- Left Column: Massive Header -->
    <div class="reveal-on-scroll lg:col-span-5">
      <h2
        class="mb-8 font-display text-[15vw] leading-[0.8] font-bold tracking-tighter text-text-main lg:sticky lg:top-32 lg:mb-0 lg:text-[10vw] xl:text-[5vw]"
      >
        About.
      </h2>
    </div>

    <!-- Right Column: Content -->
    <div
      class="reveal-on-scroll flex flex-col justify-center lg:col-span-7"
      style="transition-delay: 0.2s"
    >
      <div class="mb-12 md:mb-16">
        {
          about.description
            .split("\n\n")
            .map((paragraph) => (
              <p class="mb-6 text-base leading-relaxed font-light text-text-muted last:mb-0 md:mb-8 md:text-lg md:leading-loose lg:text-xl">
                {paragraph.trim()}
              </p>
            ))
        }
      </div>

      <!-- Minimal Stats -->
      <div
        class="grid grid-cols-2 gap-8 border-t border-border pt-8 md:gap-12 md:pt-12"
      >
        <div>
          <span
            class="mb-2 block font-display text-5xl font-bold text-text-main md:text-6xl lg:text-7xl xl:text-8xl"
            >{new Date().getFullYear() - 2019}+</span
          >
          <span
            class="block text-xs tracking-widest text-text-muted uppercase md:text-sm lg:text-base"
            >Years Experience</span
          >
        </div>
        <div>
          <span
            class="mb-2 block font-display text-5xl font-bold text-text-main md:text-6xl lg:text-7xl xl:text-8xl"
            >{projects.length}+</span
          >
          <span
            class="block text-xs tracking-widest text-text-muted uppercase md:text-sm lg:text-base"
            >Projects Done</span
          >
        </div>
      </div>

      <!-- Social Links -->
      <div class="mt-8 border-t border-border pt-8 md:mt-12 md:pt-12">
        <h3
          class="mb-4 text-xs tracking-widest text-text-muted uppercase md:mb-6 md:text-sm lg:text-base"
        >
          Connect With Me
        </h3>
        <div class="flex flex-wrap gap-3 md:gap-4">
          <!-- Email -->
          <a
            href="mailto:gospelokpara@gmail.com"
            class="group flex items-center gap-2 rounded-full border border-border bg-surface/50 px-4 py-2 transition-all hover:scale-105 hover:border-primary/50 hover:bg-surface md:gap-3 md:px-6 md:py-3"
            aria-label="Email"
          >
            <svg
              class="h-4 w-4 text-text-muted transition-colors group-hover:text-primary md:h-5 md:w-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
            <span class="text-xs font-medium md:text-sm">Email</span>
          </a>

          <!-- LinkedIn -->
          <a
            href="https://www.linkedin.com/in/gospel-chinyereugo/"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-2 rounded-full border border-border bg-surface/50 px-4 py-2 transition-all hover:scale-105 hover:border-primary/50 hover:bg-surface md:gap-3 md:px-6 md:py-3"
            aria-label="LinkedIn"
          >
            <svg
              class="h-4 w-4 text-text-muted transition-colors group-hover:text-primary md:h-5 md:w-5"
              fill="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
              ></path>
            </svg>
            <span class="text-xs font-medium md:text-sm">LinkedIn</span>
          </a>

          <!-- GitHub -->
          <a
            href="https://github.com/Ebugo"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-2 rounded-full border border-border bg-surface/50 px-4 py-2 transition-all hover:scale-105 hover:border-primary/50 hover:bg-surface md:gap-3 md:px-6 md:py-3"
            aria-label="GitHub"
          >
            <svg
              class="h-4 w-4 text-text-muted transition-colors group-hover:text-primary md:h-5 md:w-5"
              fill="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
              ></path>
            </svg>
            <span class="text-xs font-medium md:text-sm">GitHub</span>
          </a>

          <!-- Twitter -->
          <a
            href="https://twitter.com/Codebug_"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-2 rounded-full border border-border bg-surface/50 px-4 py-2 transition-all hover:scale-105 hover:border-primary/50 hover:bg-surface md:gap-3 md:px-6 md:py-3"
            aria-label="Twitter"
          >
            <svg
              class="h-4 w-4 text-text-muted transition-colors group-hover:text-primary md:h-5 md:w-5"
              fill="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"
              ></path>
            </svg>
            <span class="text-xs font-medium md:text-sm">Twitter</span>
          </a>

          <!-- Blog -->
          <a
            href="https://blog.ebugo.me/"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-2 rounded-full border border-border bg-surface/50 px-4 py-2 transition-all hover:scale-105 hover:border-primary/50 hover:bg-surface md:gap-3 md:px-6 md:py-3"
            aria-label="Blog"
          >
            <svg
              class="h-4 w-4 text-text-muted transition-colors group-hover:text-primary md:h-5 md:w-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
              ></path>
            </svg>
            <span class="text-xs font-medium md:text-sm">Blog</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</Section>
