---
import Section from "@modules/core/Section.astro";
import Card from "@modules/core/Card.astro";
import { SITE_CONTENT } from "@config";

const { projects } = SITE_CONTENT;
---

<Section fullWidth={true} class="max-w-7xl mx-auto">
  <div class="mb-16 text-center">
    <h1 class="text-4xl md:text-6xl font-bold mb-6">All Projects</h1>
    <p class="text-xl text-text-muted max-w-2xl mx-auto">
      A comprehensive list of my work, experiments, and open source contributions.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    {
      projects.map((project) => (
        <Card href={project.linkPreview} class="group h-full flex flex-col bg-surface/50 hover:bg-surface">
          <div class="aspect-video w-full overflow-hidden rounded-2xl bg-surface-2 mb-6 relative">
            {project.image ? (
              <img
                src={project.image}
                alt={project.name}
                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
              />
            ) : (
              <div class="absolute inset-0 flex items-center justify-center bg-surface-2 text-text-muted">
                <span class="text-4xl">✨</span>
              </div>
            )}
            
            <div class="absolute inset-0 bg-black/50 opacity-0 transition-opacity duration-300 group-hover:opacity-100 flex items-center justify-center gap-4">
               {project.linkPreview && (
                 <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 backdrop-blur-md text-white font-medium border border-white/20 hover:bg-white/20 transition-colors">
                  Preview
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-external-link"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                 </span>
               )}
               {project.linkSource && project.linkSource !== "#" && (
                 <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-black/50 backdrop-blur-md text-white font-medium border border-white/20 hover:bg-black/70 transition-colors">
                  Code
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-github"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                 </span>
               )}
            </div>
          </div>

          <div class="flex flex-col flex-grow">
            <h3 class="text-2xl font-bold mb-2 group-hover:text-primary transition-colors">
              {project.name}
            </h3>
            <p class="text-text-muted leading-relaxed mb-4 flex-grow text-sm">
              {project.summary}
            </p>
          </div>
        </Card>
      ))
    }
  </div>
</Section>
