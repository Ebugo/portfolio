---
interface Props {
  href?: string;
  class?: string;
}

const { href, class: className } = Astro.props;
const Element = href ? "a" : "div";
---

<Element
  href={href}
  class:list={[
    "group relative block h-full overflow-hidden rounded-3xl bg-surface border border-border/50 p-6 transition-all duration-500 hover:border-primary/50 hover:shadow-2xl hover:shadow-primary/10",
    className,
  ]}
>
  <div
    class="absolute inset-0 bg-gradient-to-br from-primary/5 via-transparent to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"
  >
  </div>
  <div class="relative z-10 h-full">
    <slot />
  </div>
</Element>
